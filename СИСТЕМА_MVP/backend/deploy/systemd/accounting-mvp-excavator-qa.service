[Unit]
Description=Accounting MVP Excavator RuStore QA
After=network.target postgresql.service redis-server.service
Requires=postgresql.service

[Service]
User=deploy
Group=www-data
WorkingDirectory=/srv/accounting-mvp-excavator-qa
EnvironmentFile=/srv/accounting-mvp-excavator-qa/.env
RuntimeDirectory=accounting-mvp-excavator-qa
RuntimeDirectoryMode=0755
ExecStart=/srv/accounting-mvp-excavator-qa/.venv/bin/gunicorn config.wsgi:application --bind unix:/run/accounting-mvp-excavator-qa/app.sock --workers 2
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
