[Unit]
Description=Accounting MVP Excavator RuStore QA
After=network.target postgresql.service redis-server.service
Requires=postgresql.service

[Service]
User=accounting-qa
Group=accounting-qa
WorkingDirectory=/srv/accounting-mvp-excavator-qa
EnvironmentFile=/srv/accounting-mvp-excavator-qa/.env
RuntimeDirectory=accounting-mvp-excavator-qa
RuntimeDirectoryMode=0750
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/accounting-mvp-excavator-qa/.venv/bin/gunicorn config.wsgi:application --bind unix:/run/accounting-mvp-excavator-qa/app.sock --umask 0007 --workers 2
NoNewPrivileges=true
PrivateTmp=true
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
