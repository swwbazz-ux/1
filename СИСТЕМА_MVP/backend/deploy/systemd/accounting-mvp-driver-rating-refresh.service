[Unit]
Description=Обновление общего серверного снимка рейтинга водителей
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=oneshot
User=deploy
WorkingDirectory=/srv/accounting-mvp
EnvironmentFile=/srv/accounting-mvp/.env
ExecStart=/srv/accounting-mvp/.venv/bin/python manage.py refresh_driver_rating_snapshots --strict
TimeoutStartSec=600
Nice=10
UMask=0027
