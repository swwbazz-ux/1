# Local SSE stand profile. Copy to .env inside THIS copy only.
# Never copy these values into the main checkout, production, or a shared .env.
DJANGO_SETTINGS_MODULE=config.settings_sse_local
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=local-sse-stand-throwaway-20261112
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8001,http://localhost:8001

DJANGO_DB_ENGINE=postgres
POSTGRES_DB=sse_local
POSTGRES_USER=sse_local
POSTGRES_PASSWORD=sse_local_only
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_CONN_MAX_AGE=0

SSE_PILOT_ENABLED=true
SSE_HEARTBEAT_SECONDS=10
SSE_SAFETY_SCAN_SECONDS=5
SSE_REAUTH_SECONDS=10
SSE_STREAM_MAX_SECONDS=900
SSE_BATCH_SIZE=200
SSE_REDIS_URL=redis://:sse_local_only@127.0.0.1:56381/0
SSE_REDIS_NAMESPACE=accounting-mvp:sse:local-20261112

# External delivery is intentionally disabled in the local stand.
DJANGO_FCM_SERVICE_ACCOUNT_FILE=
DJANGO_FCM_PROJECT_ID=
DJANGO_WEBPUSH_VAPID_PRIVATE_KEY=
DJANGO_WEBPUSH_VAPID_PUBLIC_KEY=
