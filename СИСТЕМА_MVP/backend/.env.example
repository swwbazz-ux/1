DJANGO_SECRET_KEY=replace-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_PROXY_SSL_HEADER=False
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_DB_ENGINE=sqlite

# Для локального старта пока используется SQLite.
# Целевая база для нормальной эксплуатации: PostgreSQL.
# Для сервера:
# DJANGO_DEBUG=False
# DJANGO_ALLOWED_HOSTS=82.38.40.17,localhost,127.0.0.1
# DJANGO_CSRF_TRUSTED_ORIGINS=http://82.38.40.17
# DJANGO_SECURE_PROXY_SSL_HEADER=True
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True
# DJANGO_DB_ENGINE=postgres
# POSTGRES_DB=accounting_mvp
# POSTGRES_USER=accounting_mvp
# POSTGRES_PASSWORD=replace-me
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_CONN_MAX_AGE=60

# Изолированный онлайн-стенд Экскаваторщика. Эти значения нельзя включать
# в production .env: команды сверяют флаг и точное имя отдельной базы.
# EXCAVATOR_QA_ENABLED=True
# EXCAVATOR_QA_DATABASE_NAME=accounting_mvp_excavator_qa
# EXCAVATOR_QA_LABEL=ТЕСТОВЫЙ СТЕНД
# EXCAVATOR_QA_PHONE=+79000000000
# EXCAVATOR_QA_PIN=replace-with-six-digits
# EXCAVATOR_QA_TICK_SECONDS=2
# EXCAVATOR_QA_TRANSIT_SECONDS=12
# EXCAVATOR_QA_TRUCK_COUNT=4
# EXCAVATOR_QA_PLAN_TRIPS=20
# TRUCK_POST_UNLOAD_COOLDOWN_SECONDS=12
# DJANGO_ROLE_APP_HOST_ALIASES=qa-excavator.driverform.ru=excavator_operator
# DJANGO_CACHE_KEY_PREFIX=accounting-mvp-excavator-qa

# Куда писать человеку, если система не нашла его номер при первом входе.
# Ссылка на переписку с администратором в мессенджере: номер в карточке
# правит он. Пусто — экран просто не покажет кнопку.
DJANGO_SUPPORT_CHAT_URL=
DJANGO_SUPPORT_CHAT_LABEL=Написать администратору
