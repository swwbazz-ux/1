# LOCAL EXAMPLE ONLY. Do not copy production or existing QA secrets here.
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_DEBUG=false

# Kill switch is OFF by default. Enable only inside the isolated local run.
SSE_PILOT_ENABLED=false
SSE_HEARTBEAT_SECONDS=10
SSE_SAFETY_SCAN_SECONDS=5
SSE_REAUTH_SECONDS=10
SSE_STREAM_MAX_SECONDS=900
SSE_BATCH_SIZE=200

# Dedicated disposable Redis process. DB number is not a Pub/Sub boundary;
# namespace plus an ACL (or a separate instance) provides that boundary.
SSE_REDIS_URL=redis://sse-pilot:REPLACE_WITH_LOCAL_ONLY_PASSWORD@127.0.0.1:6381/0
SSE_REDIS_NAMESPACE=accounting-mvp:sse:qa-pilot:REPLACE_WITH_RUN_ID

# External push is intentionally unavailable on the local pilot.
DJANGO_FCM_SERVICE_ACCOUNT_FILE=
DJANGO_FCM_PROJECT_ID=
DJANGO_WEBPUSH_VAPID_PRIVATE_KEY=
DJANGO_WEBPUSH_VAPID_PUBLIC_KEY=

# These must point to a disposable local database/account in a real run.
# Never paste production or existing QA values into this file.
DJANGO_DB_ENGINE=postgres
POSTGRES_DB=accounting_mvp_sse_pilot_local
POSTGRES_USER=accounting_mvp_sse_pilot_local
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_ONLY_PASSWORD
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60
DJANGO_SECRET_KEY=REPLACE_WITH_LOCAL_THROWAWAY_SECRET
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://127.0.0.1:8001
