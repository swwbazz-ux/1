# Disposable loopback-only Redis instance for the local SSE pilot.
bind 127.0.0.1 ::1
protected-mode yes
port 6381
daemonize no
supervised no

# Wakeups are disposable. PostgreSQL journal/snapshot is the recovery source.
save ""
appendonly no
maxmemory 64mb
maxmemory-policy noeviction
timeout 0
tcp-keepalive 30

# Load the companion ACL from a local path after replacing the placeholder.
# aclfile /absolute/local/path/redis-sse-pilot.acl

