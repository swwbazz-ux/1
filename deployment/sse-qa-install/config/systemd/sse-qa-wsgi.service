[Unit]
Description=Isolated SSE QA WSGI
PartOf=sse-qa.target
After=postgresql@16-sseqa.service redis-sse-qa.service
Requires=postgresql@16-sseqa.service redis-sse-qa.service
RequiresMountsFor=/srv/sse-qa

[Service]
Type=simple
User=sseqa
Group=sseqa
Slice=sse-qa.slice
WorkingDirectory=/srv/sse-qa/current/backend
EnvironmentFile=/etc/sse-qa/app.env
ExecStart=/srv/sse-qa/venv/bin/gunicorn config.wsgi:application --workers 1 --threads 2 --bind 127.0.0.1:18080 --timeout 30 --graceful-timeout 20 --max-requests 1000 --max-requests-jitter 100 --access-logfile - --error-logfile -
StandardOutput=append:/srv/sse-qa/log/wsgi.log
StandardError=append:/srv/sse-qa/log/wsgi.log
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
CPUAccounting=yes
CPUQuota=20%
MemoryAccounting=yes
MemoryMax=384M
MemorySwapMax=0
TasksMax=48
LimitNOFILE=1024
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/sse-qa/log /srv/sse-qa/current/backend/media /srv/sse-qa/current/backend/private_media
UMask=0027

[Install]
WantedBy=sse-qa.target
