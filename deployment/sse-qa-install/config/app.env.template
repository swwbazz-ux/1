DJANGO_SETTINGS_MODULE=config.settings
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=sse-qa.driverform.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://sse-qa.driverform.ru
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECRET_KEY=@@DJANGO_SECRET_KEY@@

DJANGO_DB_ENGINE=postgres
POSTGRES_DB=sseqa
POSTGRES_USER=sseqa_app
POSTGRES_PASSWORD=@@POSTGRES_APP_PASSWORD@@
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_CONN_MAX_AGE=0

SSE_PILOT_ENABLED=false
SSE_HEARTBEAT_SECONDS=10
SSE_SAFETY_SCAN_SECONDS=5
SSE_REAUTH_SECONDS=10
SSE_STREAM_MAX_SECONDS=900
SSE_BATCH_SIZE=200
SSE_REDIS_URL=redis://sseqa:@@REDIS_URL_PASSWORD@@@127.0.0.1:6381/0
SSE_REDIS_NAMESPACE=accounting-mvp:sse:qa:v1
SSE_EVENT_LOOP_LAG_PATH=/srv/sse-qa/metrics/event-loop-lag.jsonl
SSE_EVENT_LOOP_LAG_INTERVAL_SECONDS=1

DJANGO_FCM_SERVICE_ACCOUNT_FILE=
DJANGO_FCM_PROJECT_ID=
DJANGO_WEBPUSH_VAPID_PRIVATE_KEY=
DJANGO_WEBPUSH_VAPID_PUBLIC_KEY=

SSE_QA_DRIVER_PIN=@@DRIVER_PIN@@
SSE_QA_EXCAVATOR_PIN=@@EXCAVATOR_PIN@@

