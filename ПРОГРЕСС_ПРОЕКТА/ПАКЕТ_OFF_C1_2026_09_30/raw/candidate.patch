+                'local_shift_id': first['local_shift_id'],
+                'excavator_id': self.excavator.id,
+                'fuel_percent': '50',
+                'fuel': '3500',
+                'engine_hours': '1200',
+            },
+        }
+        second = self.opening('local-shift-second', sequence=3, occurred_at=second_at)
